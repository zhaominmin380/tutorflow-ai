# Local Docker Compose configuration. Copy to .env to customize it.
# This file is safe for local development only; use a unique secret outside it.
POSTGRES_USER=tutorflow
POSTGRES_PASSWORD=password
POSTGRES_DB=tutorflow
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://tutorflow:password@postgres:5432/tutorflow

API_PORT=8000
FRONTEND_PORT=5173

SECRET_KEY=local-development-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SESSION_EXPIRE_DAYS=30
SESSION_EXPIRE_HOURS=8
# HTTP localhost development only. Production must use true with HTTPS.
SESSION_COOKIE_SECURE=false

# AI remains disabled until both provider settings are supplied and consent is true.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
AI_LOG_RETENTION_DAYS=90
AI_DATA_PROCESSING_CONSENT_CONFIRMED=false
